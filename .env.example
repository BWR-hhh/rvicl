# Copy to .env (or export in your shell) and fill in with YOUR OWN credentials. Never commit real keys.

# ---- Planner API -------------------------------------------------------------------------
# The planner is an LLM reached through RPent's planner backends. The pipeline was run with
# --planner codex (OpenAI Codex SDK) and --model gpt-6-astra; any OpenAI-compatible endpoint that
# serves the model works. Leave the base URLs unset for the official endpoint; set them to use a
# relay or a self-hosted gateway.
OPENAI_API_KEY=
CODEX_API_KEY=
OPENAI_BASE_URL=
CODEX_BASE_URL=
# Planner / model selection used by scripts/run_cell.sh (run_sweep.py takes the same values as
# --planner / --model / --reasoning-effort). RPent's other backends: --planner api (OpenAI-style
# chat API) and --planner claude_code (Anthropic; needs ANTHROPIC_API_KEY and, for a relay,
# ANTHROPIC_BASE_URL). See the RPent planner docs.
RVICL_PLANNER=codex
RVICL_MODEL=gpt-6-astra
RVICL_REASONING_EFFORT=low
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ---- Checkpoints (see the RPent README for the downloads) --------------------------------
PI05_CHECKPOINT_PATH=/path/to/checkpoints/RLinf-Pi05-LIBERO-130-fullshot-SFT
SAM3_CHECKPOINT_PATH=/path/to/checkpoints/sam3/sam3.pt
LIBERO_TYPE=pro

# ---- Workspace layout (defaults: the parent directory of this repository) ----------------
# RVICL_ROOT=/path/to/workspace
# RPENT_DIR=$RVICL_ROOT/RPent
# RVICL_VIDEO_STORE=$RVICL_ROOT/task_videos
# RVICL_MEMORY_DIR=$RVICL_ROOT/memory/libero

# ---- Shared services started by scripts/start_services.sh --------------------------------
# RPENT_VLA_ENDPOINT=http://127.0.0.1:8220
# RPENT_SAM3_ENDPOINT=http://127.0.0.1:8114
