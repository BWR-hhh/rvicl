+def test_prompt_section_and_step_appear_only_when_a_video_is_bound() -> None:
+    bundle = PromptBundle(system=system_prompt, user=user_prompt)
+    local = {**PROMPT_VARS, "memory_profile": "local"}
+    with_video = bundle.render("system", variables={**local, "task_video": True})
+    without = bundle.render("system", variables={**local, "task_video": False})
+    assert "TASK VIDEO MEMORY" in with_video and "view_task_video" in with_video
+    assert "view_task_map" in with_video and "view_demo_clip" in with_video
+    assert "2 part(s)" in with_video and "LOCAL exploration corpus" in with_video
+    assert "TASK VIDEO" not in without and "view_task_video" not in without
+
